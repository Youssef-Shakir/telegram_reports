<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="ir_cron_telegram_send_scheduled_reports" model="ir.cron">
        <field name="name">Telegram: Send Scheduled Reports</field>
        <field name="model_id" ref="model_telegram_report_schedule"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_scheduled_reports()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_telegram_send_daily_summaries" model="ir.cron">
        <field name="name">Telegram: Send Daily Summaries</field>
        <field name="model_id" ref="model_telegram_daily_summary"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_daily_summaries()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

</odoo>
