<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend POS Session Form View -->
    <record id="pos_session_view_form_inherit_telegram" model="ir.ui.view">
        <field name="name">pos.session.form.inherit.telegram</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_send_telegram_summary"
                        type="object"
                        string="Send to Telegram"
                        class="btn-secondary"
                        icon="fa-telegram"
                        attrs="{'invisible': [('state', 'not in', ['opened', 'closing_control', 'closed'])]}"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group attrs="{'invisible': [('telegram_sent', '=', False)]}">
                    <field name="telegram_sent" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
